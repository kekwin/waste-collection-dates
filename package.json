{
  "name": "waste-collection-dates",
  "private": true,
  "license": "MIT",
  "version": "2.2.0",
  "type": "module",
  "description": "Vestfor tømmedatoer – lokal app",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "backend": "tsx --env-file-if-exists=.env backend/server.ts",
    "backend:watch": "tsx watch --env-file-if-exists=.env backend/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist-server/server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.32.0",
    "globals": "^15.15.0",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
